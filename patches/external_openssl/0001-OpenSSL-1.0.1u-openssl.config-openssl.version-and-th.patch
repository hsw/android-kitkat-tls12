++        }
++        if (match) {
++            *preasons &= dp->dp_reasons;
++            return 1;
+         }
+     }
+     if ((!crl->idp || !crl->idp->distpoint)
+diff --git a/crypto/x509v3/v3_purp.c b/crypto/x509v3/v3_purp.c
