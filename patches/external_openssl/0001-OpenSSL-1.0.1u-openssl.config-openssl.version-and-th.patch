+diff --git a/test/v3nametest.c b/test/v3nametest.c
+new file mode 100644
+index 0000000..af7b66e
+--- /dev/null
++++ b/test/v3nametest.c
+@@ -0,0 +1,169 @@
++/*
++ * v3nametest.c - GENERAL_NAME_cmp regression test.
++ *
++ * kktls (Android 4.4 port): OpenSSL 1.0.1u has no v3nametest.c (it
++ * arrived in 1.0.2 with X509_check_host), so this is a minimal, self-contained
++ * port of the GENERAL_NAME_cmp table test from upstream commit 97ab3c4b53,
++ * reduced to plain C (no testutil) and carrying the CVE-2023-0286 regression
++ * entry {0xa3,0x00} verbatim from upstream 2c6c9d439b. It decodes each DER
++ * blob as a GENERAL_NAME twice (distinct pointers) and checks that every name
++ * equals itself and differs from every other. Before the CVE-2023-0286 fix the
++ * GEN_X400 entry made GENERAL_NAME_cmp interpret an ASN1_STRING as an
++ * ASN1_TYPE; the self-compare of the last entry exercises that path.
++ */
++
++#include <stdio.h>
++#include <string.h>
++
++#include <openssl/x509.h>
++#include <openssl/x509v3.h>
++#include <openssl/crypto.h>
++#include <openssl/err.h>
++
++static struct gennamedata {
++    const unsigned char der[22];
++    size_t derlen;
++} gennames[] = {
++    {
++        /*
++         * [0] {
++         *   OBJECT_IDENTIFIER { 1.2.840.113554.4.1.72585.2.1 }
++         *   [0] { SEQUENCE {} }
++         * }
++         */
++        {
++            0xa0, 0x13, 0x06, 0x0d, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x12, 0x04,
++            0x01, 0x84, 0xb7, 0x09, 0x02, 0x01, 0xa0, 0x02, 0x30, 0x00
++        },
++        21
++    }, {
++        /*
++         * [0] {
++         *   OBJECT_IDENTIFIER { 1.2.840.113554.4.1.72585.2.1 }
++         *   [0] { UTF8String { "a" } }
++         * }
++         */
++        {
++            0xa0, 0x14, 0x06, 0x0d, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x12, 0x04,
++            0x01, 0x84, 0xb7, 0x09, 0x02, 0x01, 0xa0, 0x03, 0x0c, 0x01, 0x61
++        },
++        22
++    }, {
++        /*
++         * [0] {
++         *   OBJECT_IDENTIFIER { 1.2.840.113554.4.1.72585.2.1 }
++         *   [0] { UTF8String { "b" } }
++         * }
++         */
++        {
++            0xa0, 0x14, 0x06, 0x0d, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x12, 0x04,
++            0x01, 0x84, 0xb7, 0x09, 0x02, 0x01, 0xa0, 0x03, 0x0c, 0x01, 0x62
++        },
++        22
++    }, {
++        /*
++         * Regression test for CVE-2023-0286.
++         */
++        {
++            0xa3, 0x00
++        },
++        2
++    }
++};
++
++#define NELEM(x) (sizeof(x) / sizeof((x)[0]))
++
++static int test_GENERAL_NAME_cmp(void)
++{
++    size_t i, j;
++    size_t n = NELEM(gennames);
++    GENERAL_NAME **namesa = OPENSSL_malloc(sizeof(*namesa) * n);
++    GENERAL_NAME **namesb = OPENSSL_malloc(sizeof(*namesb) * n);
++    int testresult = 0;
++
++    if (namesa == NULL || namesb == NULL)
++        goto end;
++    for (i = 0; i < n; i++) {
++        namesa[i] = NULL;
++        namesb[i] = NULL;
++    }
++
++    for (i = 0; i < n; i++) {
++        const unsigned char *derp = gennames[i].der;
++
++        /*
++         * Two versions of each GENERAL_NAME so the compare always gets
++         * distinct pointers.
++         */
++        namesa[i] = d2i_GENERAL_NAME(NULL, &derp, gennames[i].derlen);
++        derp = gennames[i].der;
++        namesb[i] = d2i_GENERAL_NAME(NULL, &derp, gennames[i].derlen);
++        if (namesa[i] == NULL || namesb[i] == NULL) {
++            fprintf(stderr, "Failed to decode GENERAL_NAME %d\n", (int)i);
++            goto end;
++        }
++    }
++
++    /* Every name should be equal to itself and not equal to any others. */
++    for (i = 0; i < n; i++) {
++        for (j = 0; j < n; j++) {
++            int cmp = GENERAL_NAME_cmp(namesa[i], namesb[j]);
++
++            if (i == j) {
++                if (cmp != 0) {
++                    fprintf(stderr,
++                            "GENERAL_NAME_cmp(%d,%d) = %d, expected 0\n",
++                            (int)i, (int)j, cmp);
++                    goto end;
++                }
++            } else {
++                if (cmp == 0) {
++                    fprintf(stderr,
++                            "GENERAL_NAME_cmp(%d,%d) = 0, expected non-zero\n",
++                            (int)i, (int)j);
++                    goto end;
++                }
++            }
++        }
++    }
++    testresult = 1;
++
++ end:
++    for (i = 0; i < n; i++) {
++        if (namesa != NULL)
++            GENERAL_NAME_free(namesa[i]);
++        if (namesb != NULL)
++            GENERAL_NAME_free(namesb[i]);
++    }
++    OPENSSL_free(namesa);
++    OPENSSL_free(namesb);
++
++    return testresult;
++}
++
++int main(int argc, char **argv)
++{
++    int ret;
++
++    (void)argc;
++    (void)argv;
++
++    CRYPTO_malloc_debug_init();
++    CRYPTO_set_mem_debug_options(V_CRYPTO_MDEBUG_ALL);
++    CRYPTO_mem_ctrl(CRYPTO_MEM_CHECK_ON);
++    ERR_load_crypto_strings();
++
++    ret = test_GENERAL_NAME_cmp();
++
++    if (ret)
++        printf("PASS\n");
++    else {
++        printf("FAIL\n");
++        ERR_print_errors_fp(stderr);
++    }
++
++    CRYPTO_cleanup_all_ex_data();
++    ERR_free_strings();
++
++    return ret ? 0 : 1;
++}
