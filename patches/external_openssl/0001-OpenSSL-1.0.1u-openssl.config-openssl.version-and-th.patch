--- 
-1.7.12.3-x20-1
-
+@@ -428,7 +428,7 @@ static int int_load(dynamic_data_ctx *ctx)
+     /* Unless told not to, try a direct load */
+     if ((ctx->dir_load != 2) && (DSO_load(ctx->dynamic_dso,
