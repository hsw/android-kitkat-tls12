+From: kktls port, OpenSSL 1.0.1u (check as 1.1.0+ ASN1_TYPE_unpack_sequence)
+Subject: kktls_p12_npas_alg_get
+PKCS12_newpass() alg_get() requires the PBE parameter to be present and a
+SEQUENCE before decoding it.
+---
+diff --git a/crypto/pkcs12/p12_npas.c b/crypto/pkcs12/p12_npas.c
+index 19a855b..57b928a 100644
+--- a/crypto/pkcs12/p12_npas.c
++++ b/crypto/pkcs12/p12_npas.c
+@@ -219,6 +219,10 @@ static int alg_get(X509_ALGOR *alg, int *pnid, int *piter, int *psaltlen)
+     PBEPARAM *pbe;
+     const unsigned char *p;
+ 
++    /* kktls: as 1.1.0+ ASN1_TYPE_unpack_sequence(): a SEQUENCE is required */
++    if (alg->parameter == NULL || alg->parameter->type != V_ASN1_SEQUENCE ||
++        alg->parameter->value.sequence == NULL)
++        return 0;
+     p = alg->parameter->value.sequence->data;
+     pbe = d2i_PBEPARAM(NULL, &p, alg->parameter->value.sequence->length);
+     if (!pbe)
