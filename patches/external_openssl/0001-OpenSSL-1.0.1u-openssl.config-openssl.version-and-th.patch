diff --git a/patches/rc4_md5_harden.patch b/patches/rc4_md5_harden.patch
new file mode 100644
index 0000000..9a0d6c3
--- /dev/null
+++ b/patches/rc4_md5_harden.patch
@@ -0,0 +1,19 @@
+From: OpenSSL commit by Andy Polyakov (CVE-2017-3731), as picked by LineageOS cm-11.0 be01785, ported to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: rc4_md5_harden
+
+The TLS AAD of a decrypted record shorter than the MAC made the payload length
+wrap around; 1.0.2 has the same check, 1.0.1u does not.
+---
+diff --git a/crypto/evp/e_rc4_hmac_md5.c b/crypto/evp/e_rc4_hmac_md5.c
+index 2da1117..ca53913 100644
+--- a/crypto/evp/e_rc4_hmac_md5.c
++++ b/crypto/evp/e_rc4_hmac_md5.c
+@@ -267,6 +267,8 @@ static int rc4_hmac_md5_ctrl(EVP_CIPHER_CTX *ctx, int type, int arg,
+             len = p[arg - 2] << 8 | p[arg - 1];
+ 
+             if (!ctx->encrypt) {
++                if (len < MD5_DIGEST_LENGTH)
++                    return -1;
+                 len -= MD5_DIGEST_LENGTH;
+                 p[arg - 2] = len >> 8;
+                 p[arg - 1] = len;
