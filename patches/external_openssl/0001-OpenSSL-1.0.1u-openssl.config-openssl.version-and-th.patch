+From: OpenSSL commit b013765abf by Matt Caswell (OpenSSL_1_1_1-stable, CVE-2023-0465), adapted to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2023-0465
+check_policy()'s bad-extension loop starts at i=0 so a leaf certificate
+with EXFLAG_INVALID_POLICY is reported to the verify callback, with an
+internal-error guard. Ported to 1.0.1u's int-return convention (ret==-1);
+existing X509_F_CHECK_POLICY/ERR_R_INTERNAL_ERROR, no new macros.
+---
+diff --git a/crypto/x509/x509_vfy.c b/crypto/x509/x509_vfy.c
+index f5bec40..33b35c1 100644
+--- a/crypto/x509/x509_vfy.c
++++ b/crypto/x509/x509_vfy.c
+@@ -1673,15 +1673,23 @@ static int check_policy(X509_STORE_CTX *ctx)
+          */
+         X509 *x;
+         int i;
+-        for (i = 1; i < sk_X509_num(ctx->chain); i++) {
++        int cbcalled = 0;
++        for (i = 0; i < sk_X509_num(ctx->chain); i++) {
+             x = sk_X509_value(ctx->chain, i);
+             if (!(x->ex_flags & EXFLAG_INVALID_POLICY))
+                 continue;
++            cbcalled = 1;
+             ctx->current_cert = x;
+             ctx->error = X509_V_ERR_INVALID_POLICY_EXTENSION;
+             if (!ctx->verify_cb(0, ctx))
+                 return 0;
+         }
++        if (!cbcalled) {
++            /* Should not be able to get here */
++            X509err(X509_F_CHECK_POLICY, ERR_R_INTERNAL_ERROR);
++            return 0;
++        }
++        /* The callback ignored the error so we return success */
+         return 1;
+     }
+     if (ret == -2) {
diff --git a/patches/cve-2023-2650.patch b/patches/cve-2023-2650.patch
new file mode 100644
index 0000000..0b66a77
--- /dev/null
+++ b/patches/cve-2023-2650.patch
@@ -0,0 +1,38 @@
+From: OpenSSL commit 9e209944b3 by Richard Levitte (OpenSSL_1_1_1-stable, CVE-2023-2650), applied unchanged to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2023-2650
+
+OBJ_obj2txt() took O(n^2) time for a gigantic OID sub-identifier; OIDs in a
+peer certificate reach it before verification (NativeCrypto OID strings,
+X509_NAME printing). OIDs longer than 586 bytes are now rejected. Fixed in
+1.0.2zh and 1.1.1u (2023-05), after the last 1.0.1 release.
+---
+diff --git a/crypto/objects/obj_dat.c b/crypto/objects/obj_dat.c
+index aca382a..e67852c 100644
+--- a/crypto/objects/obj_dat.c
++++ b/crypto/objects/obj_dat.c
+@@ -516,6 +516,25 @@ int OBJ_obj2txt(char *buf, int buf_len, const ASN1_OBJECT *a, int no_name)
+     first = 1;
+     bl = NULL;
+ 
++    /*
++     * RFC 2578 (STD 58) says this about OBJECT IDENTIFIERs:
++     *
++     * > 3.5. OBJECT IDENTIFIER values
++     * >
++     * > An OBJECT IDENTIFIER value is an ordered list of non-negative
++     * > numbers. For the SMIv2, each number in the list is referred to as a
++     * > sub-identifier, there are at most 128 sub-identifiers in a value,
++     * > and each sub-identifier has a maximum value of 2^32-1 (4294967295
++     * > decimal).
++     *
++     * So a legitimate OID according to this RFC is at most (32 * 128 / 7),
++     * i.e. 586 bytes long.
++     *
++     * Ref: https://datatracker.ietf.org/doc/html/rfc2578#section-3.5
++     */
++    if (len > 586)
++        goto err;
++
+     while (len > 0) {
+         l = 0;
+         use_bn = 0;
