diff --git a/patches/kktls_channelid_state.patch b/patches/kktls_channelid_state.patch
new file mode 100644
index 0000000..41d4f82
--- /dev/null
+++ b/patches/kktls_channelid_state.patch
@@ -0,0 +1,69 @@
+From: android-kitkat-tls12 (fix of the channelid patch), OpenSSL 1.0.1u
+Subject: kktls_channelid_state
+The Channel ID settings are copied from the SSL_CTX once in SSL_new() (was
+ssl3_new(), which runs again on a method change, leaking the key reference
+and dropping per-SSL settings); s3->tlsext_channel_id_valid is cleared at
+the start of each ClientHello/ServerHello extension parse (renegotiation).
+---
+diff --git a/ssl/s3_lib.c b/ssl/s3_lib.c
+index 4325204..b3d703b 100644
+--- a/ssl/s3_lib.c
++++ b/ssl/s3_lib.c
+@@ -3001,12 +3001,12 @@ int ssl3_new(SSL *s)
+ #ifndef OPENSSL_NO_SRP
+     SSL_SRP_CTX_init(s);
+ #endif
+-#if !defined(OPENSSL_NO_TLSEXT)
+-    s->tlsext_channel_id_enabled = s->ctx->tlsext_channel_id_enabled;
+-    if (s->ctx->tlsext_channel_id_private)
+-        s->tlsext_channel_id_private =
+-            EVP_PKEY_dup(s->ctx->tlsext_channel_id_private);
+-#endif
++    /*
++     * kktls: the Channel ID settings are copied from the SSL_CTX once, in
++     * SSL_new(); ssl3_new() runs again on a method change (SSL_clear(),
++     * SSL_set_ssl_method(), SSL_copy_session_id(), SSL_dup()), where the copy
++     * leaked the old key reference and dropped the per-SSL settings.
++     */
+     s->method->ssl_clear(s);
+     return (1);
+  err:
+diff --git a/ssl/ssl_lib.c b/ssl/ssl_lib.c
+index 49d7c06..01508b6 100644
+--- a/ssl/ssl_lib.c
