new file mode 100644
index 0000000..4edc97c
--- /dev/null
+++ b/patches/kktls_alpn_empty.patch
@@ -0,0 +1,25 @@
+From: kktls port, OpenSSL 1.0.1u (server ALPN companion of the CVE-2024-5535 NPN follow-up)
+Subject: kktls_alpn_empty
+The server rejects an ALPN select callback that returns SSL_TLSEXT_ERR_OK
+with selected_len == 0 (internal_error), explicitly instead of through
+OPENSSL_malloc(0) returning NULL.
+---
+diff --git a/ssl/t1_lib.c b/ssl/t1_lib.c
+index 2414364..bc1ca7b 100644
+--- a/ssl/t1_lib.c
++++ b/ssl/t1_lib.c
+@@ -1081,6 +1081,14 @@ static int tls1_alpn_handle_client_hello(SSL *s, const unsigned char *data,
+     r = s->ctx->alpn_select_cb(s, &selected, &selected_len, data, data_len,
+                                s->ctx->alpn_select_cb_arg);
+     if (r == SSL_TLSEXT_ERR_OK) {
++        /*
++         * kktls: an empty selection is a callback error; reject it explicitly
++         * (it failed before only because OPENSSL_malloc(0) returns NULL).
++         */
++        if (selected_len == 0) {
++            *al = SSL_AD_INTERNAL_ERROR;
++            return -1;
++        }
+         if (s->s3->alpn_selected)
+             OPENSSL_free(s->s3->alpn_selected);
+         s->s3->alpn_selected = OPENSSL_malloc(selected_len);
diff --git a/patches/kktls_armcap_neon.patch b/patches/kktls_armcap_neon.patch
new file mode 100644
index 0000000..932db71
--- /dev/null
+++ b/patches/kktls_armcap_neon.patch
@@ -0,0 +1,119 @@
+From: kktls port, OpenSSL 1.0.1u (NEON on Android 4.4 ARM)
+Subject: kktls_armcap_neon
+OPENSSL_cpuid_setup() sets ARMV7_NEON from getauxval(AT_HWCAP) instead of
+SIGILL probes; ARMV7_TICK is never set and the OPENSSL_armcap override is
+masked to ARMV7_NEON. armcap.c keeps the stock export cleanse_ctr (mem_clr.c
+is not built on arm any more). armv4cpuid.S: OPENSSL_armcap_P stays exported
+(no .hidden), as in the stock Android 4.4 libcrypto.
+---
+diff --git a/crypto/armcap.c b/crypto/armcap.c
+index 28522ea..d9b50ed 100644
+--- a/crypto/armcap.c
++++ b/crypto/armcap.c
+@@ -1,27 +1,26 @@
+-#include <stdio.h>
+ #include <stdlib.h>
+-#include <string.h>
+-#include <setjmp.h>
+-#include <signal.h>
++#include <sys/auxv.h>
+ #include <crypto.h>
+ 
+ #include "arm_arch.h"
+ 
+-unsigned int OPENSSL_armcap_P;
++/* the kernel's NEON hwcap bit (asm/hwcap.h; bionic's and glibc's sys/auxv.h do not define it) */
++#ifndef HWCAP_NEON
++# define HWCAP_NEON (1 << 12)
++#endif
+ 
+-static sigset_t all_masked;
++unsigned int OPENSSL_armcap_P;
+ 
+-static sigjmp_buf ill_jmp;
+-static void ill_handler(int sig)
+-{
+-    siglongjmp(ill_jmp, sig);
+-}
++/*
++ * kktls: the stock Android 4.4 libcrypto exports cleanse_ctr (from mem_clr.c,
++ * which this build replaces with armv4cpuid.S); kept so no stock export goes.
++ */
++unsigned char cleanse_ctr = 0;
+ 
+ /*
+  * Following subroutines could have been inlined, but it's not all
+  * ARM compilers support inline assembler...
+  */
+-void _armv7_neon_probe(void);
+ unsigned int _armv7_tick(void);
+ 
+ unsigned int OPENSSL_rdtsc(void)
+@@ -32,14 +31,18 @@ unsigned int OPENSSL_rdtsc(void)
+         return 0;
+ }
+ 
++/*
++ * kktls: NEON from the kernel's AT_HWCAP (getauxval, Android 4.3+) instead of
++ * running a NEON and an mrrc instruction under a SIGILL handler in every
++ * process that loads libcrypto. ARMV7_TICK is never set (OPENSSL_rdtsc
++ * returns 0), and the OPENSSL_armcap override is masked to ARMV7_NEON.
++ */
+ #if defined(__GNUC__) && __GNUC__>=2
+ void OPENSSL_cpuid_setup(void) __attribute__ ((constructor));
+ #endif
+ void OPENSSL_cpuid_setup(void)
+ {
+     char *e;
+-    struct sigaction ill_oact, ill_act;
+-    sigset_t oset;
+     static int trigger = 0;
+ 
+     if (trigger)
+@@ -47,35 +50,11 @@ void OPENSSL_cpuid_setup(void)
+     trigger = 1;
+ 
+     if ((e = getenv("OPENSSL_armcap"))) {
+-        OPENSSL_armcap_P = strtoul(e, NULL, 0);
++        OPENSSL_armcap_P = strtoul(e, NULL, 0) & ARMV7_NEON;
+         return;
+     }
+ 
+-    sigfillset(&all_masked);
+-    sigdelset(&all_masked, SIGILL);
+-    sigdelset(&all_masked, SIGTRAP);
+-    sigdelset(&all_masked, SIGFPE);
+-    sigdelset(&all_masked, SIGBUS);
+-    sigdelset(&all_masked, SIGSEGV);
+-
+     OPENSSL_armcap_P = 0;
+-
+-    memset(&ill_act, 0, sizeof(ill_act));
+-    ill_act.sa_handler = ill_handler;
+-    ill_act.sa_mask = all_masked;
+-
+-    sigprocmask(SIG_SETMASK, &ill_act.sa_mask, &oset);
+-    sigaction(SIGILL, &ill_act, &ill_oact);
+-
+-    if (sigsetjmp(ill_jmp, 1) == 0) {
+-        _armv7_neon_probe();
++    if (getauxval(AT_HWCAP) & HWCAP_NEON)
+         OPENSSL_armcap_P |= ARMV7_NEON;
+-    }
+-    if (sigsetjmp(ill_jmp, 1) == 0) {
+-        _armv7_tick();
+-        OPENSSL_armcap_P |= ARMV7_TICK;
+-    }
+-
+-    sigaction(SIGILL, &ill_oact, NULL);
+-    sigprocmask(SIG_SETMASK, &oset, NULL);
+ }
+diff --git a/crypto/armv4cpuid.S b/crypto/armv4cpuid.S
+index 2d618de..4d9ae63 100644
+--- a/crypto/armv4cpuid.S
++++ b/crypto/armv4cpuid.S
+@@ -151,4 +151,3 @@ atomic_add_spinlock:
+ #endif
+ 
+ .comm	OPENSSL_armcap_P,4,4
+-.hidden	OPENSSL_armcap_P
