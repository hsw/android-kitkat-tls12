diff --git a/patches/cve-2022-0778.patch b/patches/cve-2022-0778.patch
new file mode 100644
index 0000000..9db26b6
--- /dev/null
+++ b/patches/cve-2022-0778.patch
@@ -0,0 +1,56 @@
+From: OpenSSL commit 3118eb6493 by Tomas Mraz (OpenSSL_1_1_1-stable, CVE-2022-0778), applied unchanged to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2022-0778
+
+BN_mod_sqrt() looped forever for some non-prime p; a peer certificate with
+explicit EC parameters reaches it before verification. Fixed in 1.0.2zd and
+1.1.1n (2022-03), after the last 1.0.1 release.
+---
+diff --git a/crypto/bn/bn_sqrt.c b/crypto/bn/bn_sqrt.c
+index 232af99..3504952 100644
+--- a/crypto/bn/bn_sqrt.c
++++ b/crypto/bn/bn_sqrt.c
+@@ -64,7 +64,8 @@ BIGNUM *BN_mod_sqrt(BIGNUM *in, const BIGNUM *a, const BIGNUM *p, BN_CTX *ctx)
+ /*
+  * Returns 'ret' such that ret^2 == a (mod p), using the Tonelli/Shanks
+  * algorithm (cf. Henri Cohen, "A Course in Algebraic Computational Number
+- * Theory", algorithm 1.5.1). 'p' must be prime!
++ * Theory", algorithm 1.5.1). 'p' must be prime, otherwise an error or
++ * an incorrect "result" will be returned.
+  */
+ {
+     BIGNUM *ret = in;
+@@ -350,18 +351,23 @@ BIGNUM *BN_mod_sqrt(BIGNUM *in, const BIGNUM *a, const BIGNUM *p, BN_CTX *ctx)
+             goto vrfy;
+         }
+ 
+-        /* find smallest  i  such that  b^(2^i) = 1 */
+-        i = 1;
+-        if (!BN_mod_sqr(t, b, p, ctx))
+-            goto end;
+-        while (!BN_is_one(t)) {
+-            i++;
+-            if (i == e) {
+-                BNerr(BN_F_BN_MOD_SQRT, BN_R_NOT_A_SQUARE);
+-                goto end;
++        /* Find the smallest i, 0 < i < e, such that b^(2^i) = 1. */
++        for (i = 1; i < e; i++) {
++            if (i == 1) {
++                if (!BN_mod_sqr(t, b, p, ctx))
++                    goto end;
++
++            } else {
++                if (!BN_mod_mul(t, t, t, p, ctx))
++                    goto end;
+             }
+-            if (!BN_mod_mul(t, t, t, p, ctx))
+-                goto end;
++            if (BN_is_one(t))
++                break;
++        }
++        /* If not found, a is not a square or p is not prime. */
++        if (i >= e) {
++            BNerr(BN_F_BN_MOD_SQRT, BN_R_NOT_A_SQUARE);
++            goto end;
+         }
+ 
+         /* t := y^2^(e - i - 1) */
diff --git a/patches/cve-2023-0215.patch b/patches/cve-2023-0215.patch
new file mode 100644
index 0000000..010c4e5
--- /dev/null
+++ b/patches/cve-2023-0215.patch
@@ -0,0 +1,44 @@
+From: OpenSSL commit c3829dd882 by Matt Caswell (OpenSSL_1_1_1-stable, CVE-2023-0215), adapted to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2023-0215
+On any error after BIO_push(), BIO_new_NDEF() does (void)BIO_pop(pop_bio)
+before BIO_free(asn_bio) so the caller's BIO is cleanly detached (use-after-free
+on failed S/MIME streaming output). Partial port: 1.0.1u asn1_bio_free()
+does not free ex_arg, so SET_EX_ARG stays after asn1_cb and ndef_aux is
+still freed on error.
+---
+diff --git a/crypto/asn1/bio_ndef.c b/crypto/asn1/bio_ndef.c
+index 31949b8..8713610 100644
+--- a/crypto/asn1/bio_ndef.c
++++ b/crypto/asn1/bio_ndef.c
+@@ -101,6 +101,7 @@ BIO *BIO_new_NDEF(BIO *out, ASN1_VALUE *val, const ASN1_ITEM *it)
+     BIO *asn_bio = NULL;
+     const ASN1_AUX *aux = it->funcs;
+     ASN1_STREAM_ARG sarg;
++    BIO *pop_bio = NULL;
+ 
+     if (!aux || !aux->asn1_cb) {
+         ASN1err(ASN1_F_BIO_NEW_NDEF, ASN1_R_STREAMING_NOT_SUPPORTED);
+@@ -116,6 +117,14 @@ BIO *BIO_new_NDEF(BIO *out, ASN1_VALUE *val, const ASN1_ITEM *it)
+     if (!ndef_aux || !asn_bio || !out)
+         goto err;
+ 
++    /*
++     * The BIO_push() above made asn_bio own the caller's out BIO as part of
++     * its chain. On any error below we must detach it again with BIO_pop()
++     * (see the err: block) so that only asn_bio is freed and the caller keeps
++     * its own BIO (CVE-2023-0215).
++     */
++    pop_bio = asn_bio;
++
+     BIO_asn1_set_prefix(asn_bio, ndef_prefix, ndef_prefix_free);
+     BIO_asn1_set_suffix(asn_bio, ndef_suffix, ndef_suffix_free);
+ 
+@@ -142,6 +151,8 @@ BIO *BIO_new_NDEF(BIO *out, ASN1_VALUE *val, const ASN1_ITEM *it)
+     return sarg.ndef_bio;
+ 
+  err:
++    /* BIO_pop() is NULL safe */
++    (void)BIO_pop(pop_bio);
+     if (asn_bio)
+         BIO_free(asn_bio);
+     if (ndef_aux)
diff --git a/patches/cve-2023-0286.patch b/patches/cve-2023-0286.patch
new file mode 100644
index 0000000..e27d3c3
--- /dev/null
+++ b/patches/cve-2023-0286.patch
@@ -0,0 +1,280 @@
+From: OpenSSL commit 2c6c9d439b by Hugo Landau (OpenSSL_1_1_1-stable, CVE-2023-0286), adapted to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2023-0286
+
+The GENERAL_NAME ASN.1 template parses x400Address as an ASN1_STRING
+(ASN1_SEQUENCE) but GENERAL_NAME_cmp() compared it with ASN1_TYPE_cmp(), a
+type confusion that gives an attacker-controlled read primitive from a
+crafted certificate. kktls port of upstream 2c6c9d439b (1.1.1): compare it with
+ASN1_STRING_cmp() instead. Per plan the union field x400Address keeps its
+ASN1_TYPE* declaration (no ABI change: same pointer size), so the compare
+casts to ASN1_STRING* rather than changing x509v3.h. 1.0.1u has no
+v3nametest.c (it arrived in 1.0.2), so the test hunk adds a minimal,
+self-contained plain-C port of the upstream 97ab3c4b53 GENERAL_NAME_cmp table
+test carrying the CVE-2023-0286 regression entry {0xa3,0x00} verbatim and
+wires test_v3name into test/Makefile as 1.0.2u does. Fixed upstream on the
+1.1.1 branch, after the last 1.0.1 release.
+---
+diff --git a/crypto/x509v3/v3_genn.c b/crypto/x509v3/v3_genn.c
+index b1d3272..8919b38 100644
+--- a/crypto/x509v3/v3_genn.c
++++ b/crypto/x509v3/v3_genn.c
+@@ -147,7 +147,14 @@ int GENERAL_NAME_cmp(GENERAL_NAME *a, GENERAL_NAME *b)
+         return -1;
+     switch (a->type) {
+     case GEN_X400:
+-        result = ASN1_TYPE_cmp(a->d.x400Address, b->d.x400Address);
