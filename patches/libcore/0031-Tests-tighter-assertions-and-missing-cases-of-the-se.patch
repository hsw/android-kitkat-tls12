+    private static void assertClientRefusesWeakDhGroup(TestSSLContext c, String[] clientSuites,
+            String[] serverSuites, String cipherSuite) throws Exception {
+        final SSLSocket client = (SSLSocket) c.clientContext.getSocketFactory().createSocket(
+                c.host, c.port);
+        final SSLSocket server = (SSLSocket) c.serverSocket.accept();
+        client.setEnabledCipherSuites(clientSuites);
