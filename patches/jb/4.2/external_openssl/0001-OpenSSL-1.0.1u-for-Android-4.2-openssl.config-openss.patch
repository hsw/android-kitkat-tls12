diff --git a/patches/cve-2024-5535.patch b/patches/cve-2024-5535.patch
new file mode 100644
index 000000000..f83dd0b80
--- /dev/null
+++ b/patches/cve-2024-5535.patch
@@ -0,0 +1,94 @@
+From: OpenSSL commit cf6f91f612 by Matt Caswell (openssl-3.0, CVE-2024-5535), ported by hand to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2024-5535
+
+SSL_select_next_proto() read the first byte of the client list even when the
+list was empty, and trusted the length bytes of both lists. kktls port: 1.0.1u
+has no PACKET API, so the same parsing is done with explicit bounds checks;
+an empty or malformed client list returns OPENSSL_NPN_NO_OVERLAP with
+*out = NULL, *outlen = 0; return values are unchanged. Fixed in 1.0.2zk and
+3.x (2024-06), after the last 1.0.1 release.
+---
+diff --git a/ssl/ssl_lib.c b/ssl/ssl_lib.c
+index 4a6cdb2..49d7c06 100644
+--- a/ssl/ssl_lib.c
++++ b/ssl/ssl_lib.c
+@@ -1602,37 +1602,57 @@ int SSL_select_next_proto(unsigned char **out, unsigned char *outlen,
+                           const unsigned char *client,
+                           unsigned int client_len)
+ {
+-    unsigned int i, j;
+-    const unsigned char *result;
+-    int status = OPENSSL_NPN_UNSUPPORTED;
++    unsigned int i, j, slen, clen;
++
++    /*
++     * kktls port of upstream cf6f91f612 (CVE-2024-5535). 1.0.1u has no PACKET
++     * API, so the length-prefixed parsing is done with explicit bounds
++     * checks; the behaviour follows upstream: an empty or malformed client
++     * list gives NO_OVERLAP with *out = NULL, *outlen = 0, zero-length
++     * server entries are skipped and truncated trailing entries in either
++     * list are ignored instead of read past the end.
++     */
++    if (client_len == 0 || client[0] == 0 || client[0] > client_len - 1) {
++        *out = NULL;
++        *outlen = 0;
++        return OPENSSL_NPN_NO_OVERLAP;
++    }
++
++    /*
++     * Set the default opportunistic protocol. Will be overwritten if we find
++     * a match.
++     */
++    *out = (unsigned char *)client + 1;
++    *outlen = client[0];
+ 
+     /*
+      * For each protocol in server preference order, see if we support it.
+      */
+-    for (i = 0; i < server_len;) {
+-        for (j = 0; j < client_len;) {
+-            if (server[i] == client[j] &&
+-                memcmp(&server[i + 1], &client[j + 1], server[i]) == 0) {
++    for (i = 0; i < server_len; i += slen + 1) {
++        slen = server[i];
++        if (slen > server_len - i - 1)
++            break;              /* Ignore spurious trailing bytes */
++        if (slen == 0)
++            continue;           /* Invalid - ignore it */
++        for (j = 0; j < client_len; j += clen + 1) {
++            clen = client[j];
++            if (clen > client_len - j - 1)
++                break;          /* Ignore spurious trailing bytes */
++            if (clen == slen && memcmp(&server[i + 1], &client[j + 1],
++                                       slen) == 0) {
+                 /* We found a match */
+-                result = &server[i];
+-                status = OPENSSL_NPN_NEGOTIATED;
+-                goto found;
++                *out = (unsigned char *)&server[i + 1];
++                *outlen = (unsigned char)slen;
++                return OPENSSL_NPN_NEGOTIATED;
+             }
+-            j += client[j];
+-            j++;
+         }
+-        i += server[i];
+-        i++;
+     }
+ 
+-    /* There's no overlap between our protocols and the server's list. */
+-    result = client;
+-    status = OPENSSL_NPN_NO_OVERLAP;
+-
+- found:
+-    *out = (unsigned char *)result + 1;
+-    *outlen = result[0];
+-    return status;
++    /*
++     * There's no overlap between our protocols and the server's list. We use
++     * the default opportunistic protocol selected earlier
++     */
++    return OPENSSL_NPN_NO_OVERLAP;
+ }
+ 
+ /*
