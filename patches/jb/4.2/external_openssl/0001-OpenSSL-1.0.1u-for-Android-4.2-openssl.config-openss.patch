diff --git a/patches/kktls_cert_chain.patch b/patches/kktls_cert_chain.patch
new file mode 100644
index 000000000..abe9341f8
--- /dev/null
+++ b/patches/kktls_cert_chain.patch
@@ -0,0 +1,60 @@
+From: android-kitkat-tls12 (fix of the jsse patch), OpenSSL 1.0.1u
+Subject: kktls_cert_chain
+ssl_cert_free() frees CERT_PKEY.cert_chain (set by SSL_use_certificate_chain,
+which takes ownership) and ssl_cert_dup() copies it with new references.
+---
+diff --git a/ssl/ssl_cert.c b/ssl/ssl_cert.c
+index 84f3e9a..db57f27 100644
+--- a/ssl/ssl_cert.c
++++ b/ssl/ssl_cert.c
+@@ -260,6 +260,21 @@ CERT *ssl_cert_dup(CERT *cert)
+             CRYPTO_add(&ret->pkeys[i].privatekey->references, 1,
+                        CRYPTO_LOCK_EVP_PKEY);
+         }
++
++        /* kktls: the per-key chain (SSL_use_certificate_chain) is owned too */
++        if (cert->pkeys[i].cert_chain != NULL) {
++            int j;
++
++            ret->pkeys[i].cert_chain = sk_X509_dup(cert->pkeys[i].cert_chain);
++            if (ret->pkeys[i].cert_chain == NULL) {
++                SSLerr(SSL_F_SSL_CERT_DUP, ERR_R_MALLOC_FAILURE);
++                goto err;
++            }
++            for (j = 0; j < sk_X509_num(ret->pkeys[i].cert_chain); j++)
++                CRYPTO_add(&sk_X509_value(ret->pkeys[i].cert_chain,
++                                          j)->references, 1,
++                           CRYPTO_LOCK_X509);
++        }
+     }
+ 
+     /*
+@@ -269,9 +284,7 @@ CERT *ssl_cert_dup(CERT *cert)
+ 
+     return (ret);
+ 
+-#if !defined(OPENSSL_NO_DH) || !defined(OPENSSL_NO_ECDH)
+  err:
+-#endif
+ #ifndef OPENSSL_NO_RSA
+     if (ret->rsa_tmp != NULL)
+         RSA_free(ret->rsa_tmp);
+@@ -290,6 +303,8 @@ CERT *ssl_cert_dup(CERT *cert)
+             X509_free(ret->pkeys[i].x509);
+         if (ret->pkeys[i].privatekey != NULL)
+             EVP_PKEY_free(ret->pkeys[i].privatekey);
++        if (ret->pkeys[i].cert_chain != NULL)
++            sk_X509_pop_free(ret->pkeys[i].cert_chain, X509_free);
+     }
+ 
+     return NULL;
+@@ -333,6 +348,9 @@ void ssl_cert_free(CERT *c)
+             X509_free(c->pkeys[i].x509);
+         if (c->pkeys[i].privatekey != NULL)
+             EVP_PKEY_free(c->pkeys[i].privatekey);
++        /* kktls: free the per-key chain (SSL_use_certificate_chain owns it) */
++        if (c->pkeys[i].cert_chain != NULL)
++            sk_X509_pop_free(c->pkeys[i].cert_chain, X509_free);
+ #if 0
+         if (c->pkeys[i].publickey != NULL)
+             EVP_PKEY_free(c->pkeys[i].publickey);
