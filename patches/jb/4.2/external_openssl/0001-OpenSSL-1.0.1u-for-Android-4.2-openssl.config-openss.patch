diff --git a/patches/cve-2026-45447.patch b/patches/cve-2026-45447.patch
new file mode 100644
index 000000000..d7d6ada46
--- /dev/null
+++ b/patches/cve-2026-45447.patch
@@ -0,0 +1,44 @@
+From: OpenSSL commit 9dfd688ad2 by Igor Ustinov (CVE-2026-45447), adapted to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2026-45447
+
+On the error/cleanup path PKCS7_verify() used BIO_free_all(p7bio), freeing the
+whole BIO chain including the caller-owned indata (and, after BIO_pop, a
+possible double-free): a use-after-free reachable from PKCS#7 verification of
+untrusted input. kktls port of upstream 9dfd688ad2: pop and BIO_free() only the
+BIOs in front of indata, leaving indata untouched. In 1.0.1u p7bio is assigned
+(NULL or a chain) before any goto err, so the loop guard is safe. Fixed
+upstream in 2026, after the last 1.0.1 release.
+---
+diff --git a/crypto/pkcs7/pk7_smime.c b/crypto/pkcs7/pk7_smime.c
+index dbd4100..0d806fc 100644
+--- a/crypto/pkcs7/pk7_smime.c
++++ b/crypto/pkcs7/pk7_smime.c
+@@ -258,6 +258,7 @@ int PKCS7_verify(PKCS7 *p7, STACK_OF(X509) *certs, X509_STORE *store,
+     int i, j = 0, k, ret = 0;
+     BIO *p7bio;
+     BIO *tmpin, *tmpout;
++    BIO *next = NULL;
+ 
+     if (!p7) {
+         PKCS7err(PKCS7_F_PKCS7_VERIFY, PKCS7_R_INVALID_NULL_POINTER);
+@@ -399,11 +400,16 @@ int PKCS7_verify(PKCS7 *p7, STACK_OF(X509) *certs, X509_STORE *store,
+ 
+  err:
+ 
+-    if (tmpin == indata) {
+-        if (indata)
+-            BIO_pop(p7bio);
++    /*
++     * CVE-2026-45447: free only the BIOs PKCS7_dataInit() pushed in front of
++     * indata, one at a time with BIO_free(), so the caller's indata is never
++     * freed and the pushed chain is not double-freed.
++     */
++    while (p7bio != NULL && p7bio != indata) {
++        next = BIO_pop(p7bio);
++        BIO_free(p7bio);
++        p7bio = next;
+     }
+-    BIO_free_all(p7bio);
+ 
+     sk_X509_free(signers);
+ 
