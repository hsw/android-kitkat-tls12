diff --git a/patches/cve-2020-1971.patch b/patches/cve-2020-1971.patch
new file mode 100644
index 000000000..a6d2f4b40
--- /dev/null
+++ b/patches/cve-2020-1971.patch
@@ -0,0 +1,94 @@
+From: OpenSSL commit f960d81215 by Matt Caswell (OpenSSL_1_1_1-stable, CVE-2020-1971), adapted to OpenSSL 1.0.1u for android-kitkat-tls12
+Subject: cve-2020-1971
+
+GENERAL_NAME_cmp() handled GEN_EDIPARTY (and GEN_X400) through the "other"
+ASN1_TYPE branch, so an EdiPartyName was compared with ASN1_TYPE_cmp() over a
+struct that is not an ASN1_TYPE: a NULL deref / crash reachable from a
+crafted GENERAL_NAME (e.g. CRL distribution point or timestamp). kktls port of
+upstream 1.1.1 f960d81215: adds edipartyname_cmp() and compares the correctly
+typed union members; GENERAL_NAME_set0_value/get0_value split GEN_X400 and
+GEN_EDIPARTY (union aliases, no behaviour change). The header keeps
+x400Address as ASN1_TYPE* (GEN_X400 still via ASN1_TYPE_cmp here; that part is
+fixed by CVE-2023-0286). Fixed upstream on the 1.1.1 branch, after the last
+1.0.1 release.
+---
+diff --git a/crypto/x509v3/v3_genn.c b/crypto/x509v3/v3_genn.c
+index 7f40bfa..b1d3272 100644
+--- a/crypto/x509v3/v3_genn.c
++++ b/crypto/x509v3/v3_genn.c
+@@ -107,6 +107,37 @@ GENERAL_NAME *GENERAL_NAME_dup(GENERAL_NAME *a)
+                                     (char *)a);
+ }
+ 
++static int edipartyname_cmp(const EDIPARTYNAME *a, const EDIPARTYNAME *b)
++{
++    int res;
++
++    if (a == NULL || b == NULL) {
++        /*
++         * Shouldn't be possible in a valid GENERAL_NAME, but we handle it
++         * anyway. OTHERNAME_cmp treats NULL != NULL so we do the same here
++         */
++        return -1;
++    }
++    if (a->nameAssigner == NULL && b->nameAssigner != NULL)
++        return -1;
++    if (a->nameAssigner != NULL && b->nameAssigner == NULL)
++        return 1;
++    /* If we get here then both have nameAssigner set, or both unset */
++    if (a->nameAssigner != NULL) {
++        res = ASN1_STRING_cmp(a->nameAssigner, b->nameAssigner);
++        if (res != 0)
++            return res;
++    }
++    /*
++     * partyName is required, so these should never be NULL. We treat it in
++     * the same way as the a == NULL || b == NULL case above
++     */
++    if (a->partyName == NULL || b->partyName == NULL)
++        return -1;
++
++    return ASN1_STRING_cmp(a->partyName, b->partyName);
++}
++
+ /* Returns 0 if they are equal, != 0 otherwise. */
+ int GENERAL_NAME_cmp(GENERAL_NAME *a, GENERAL_NAME *b)
+ {
+@@ -116,8 +147,11 @@ int GENERAL_NAME_cmp(GENERAL_NAME *a, GENERAL_NAME *b)
+         return -1;
+     switch (a->type) {
+     case GEN_X400:
++        result = ASN1_TYPE_cmp(a->d.x400Address, b->d.x400Address);
++        break;
++
+     case GEN_EDIPARTY:
+-        result = ASN1_TYPE_cmp(a->d.other, b->d.other);
++        result = edipartyname_cmp(a->d.ediPartyName, b->d.ediPartyName);
+         break;
+ 
+     case GEN_OTHERNAME:
+@@ -164,8 +198,11 @@ void GENERAL_NAME_set0_value(GENERAL_NAME *a, int type, void *value)
+ {
+     switch (type) {
+     case GEN_X400:
