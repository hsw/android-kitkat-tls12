+    public void test_SSLSocket_SNI_propertyIgnoresCase() throws Exception {
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        String old = System.getProperty("jsse.enableSNIExtension");
+        try {
+            for (String on : new String[] { "TRUE", "True", "true" }) {
+                System.setProperty("jsse.enableSNIExtension", on);
+                assertEquals(on, Arrays.asList("sni-wrapped.tls.test"), captureSniHostnames(
+                        wrappingClientSocketMaker(sf, "sni-wrapped.tls.test")));
+            }
+            for (String off : new String[] { "FALSE", "False" }) {
+                System.setProperty("jsse.enableSNIExtension", off);
+                assertNull(off, captureSniHostnames(
+                        wrappingClientSocketMaker(sf, "sni-wrapped.tls.test")));
+            }
+        } finally {
+            restoreProperty("jsse.enableSNIExtension", old);
+        }
+    }
+
+    /**
+     * kktls: a jsse.enableSNIExtension value other than true/false keeps SNI on (and logs once);
+     * upstream 966ae8a throws a RuntimeException from every client handshake instead.
+     */
+    public void test_SSLSocket_SNI_invalidPropertyKeepsSniOn() throws Exception {
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        String old = System.getProperty("jsse.enableSNIExtension");
+        try {
+            for (String invalid : new String[] { "yes", "0", "", " true" }) {
+                System.setProperty("jsse.enableSNIExtension", invalid);
+                assertEquals("\"" + invalid + "\"", Arrays.asList("sni-wrapped.tls.test"),
+                        captureSniHostnames(wrappingClientSocketMaker(sf, "sni-wrapped.tls.test")));
+            }
+        } finally {
+            restoreProperty("jsse.enableSNIExtension", old);
+        }
+    }
+
+    /** kktls: an explicit setHostname() of a name that is not an FQDN sends no SNI (RFC 6066). */
+    public void test_SSLSocket_SNI_setHostnameNotFqdn() throws Exception {
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        for (String name : new String[] { "localhost", "" }) {
+            assertNull("setHostname(\"" + name + "\")", captureSniHostnames(withSetHostname(
+                    wrappingClientSocketMaker(sf, "sni-wrapped.tls.test"), name)));
+        }
+    }
+
+    private static void restoreProperty(String key, String old) {
+        if (old == null) {
+            System.clearProperty(key);
+        } else {
+            System.setProperty(key, old);
+        }
+    }
+
