@@ -465,6 +465,12 @@ public class OpenSSLSocketImpl
     /**
      * Returns whether Server Name Indication (SNI) is enabled by default for
      * sockets. For more information on SNI, see RFC 6066 section 3.
+     *
+     * <p>kktls: {@code jsse.enableSNIExtension} is {@code true} or {@code false}, in any case. Any
+     * other value keeps SNI on (the default) and logs one warning per process. Upstream (966ae8a)
+     * throws a RuntimeException from every client handshake instead; 4.4 never read the property,
+     * so an app that sets it to some other value would otherwise lose every TLS connection, and an
+     * unchecked exception escapes callers that catch only IOException (okhttp).
      */
     private static boolean isSniEnabledByDefault() {
         String enableSNI = System.getProperty("jsse.enableSNIExtension", "true");
@@ -472,12 +478,18 @@ public class OpenSSLSocketImpl
             return true;
         } else if ("false".equalsIgnoreCase(enableSNI)) {
             return false;
-        } else {
-            throw new RuntimeException(
-                    "Can only set \"jsse.enableSNIExtension\" to \"true\" or \"false\"");
         }
+        if (!invalidSniPropertyLogged) {
+            invalidSniPropertyLogged = true;
+            System.logW("jsse.enableSNIExtension=\"" + enableSNI
+                    + "\" is neither \"true\" nor \"false\"; SNI stays enabled");
+        }
+        return true;
     }
 
+    /** kktls: the warning of {@link #isSniEnabledByDefault} is logged once per process. */
+    private static volatile boolean invalidSniPropertyLogged;
