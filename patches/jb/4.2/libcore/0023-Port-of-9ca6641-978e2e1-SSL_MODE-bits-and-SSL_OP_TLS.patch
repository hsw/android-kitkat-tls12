 .../xnet/provider/jsse/NativeCrypto.java      |  9 ++--
 .../libcore/javax/net/ssl/SSLSocketTest.java  | 49 +++++++++++++++++++
 .../xnet/provider/jsse/NativeCryptoTest.java  |  2 +
 3 files changed, 57 insertions(+), 3 deletions(-)

diff --git a/luni/src/main/java/org/apache/harmony/xnet/provider/jsse/NativeCrypto.java b/luni/src/main/java/org/apache/harmony/xnet/provider/jsse/NativeCrypto.java
index e1d824aea22..18038936e8b 100644
--- a/luni/src/main/java/org/apache/harmony/xnet/provider/jsse/NativeCrypto.java
+++ b/luni/src/main/java/org/apache/harmony/xnet/provider/jsse/NativeCrypto.java
@@ -405,11 +405,14 @@ public final class NativeCrypto {
     public static final int RSA_PKCS1_PADDING = 1;
     public static final int RSA_NO_PADDING    = 3;
 
-    // SSL mode from ssl.h
-    public static final long SSL_MODE_HANDSHAKE_CUTTHROUGH = 0x00000040L;
-    public static final long SSL_MODE_SEND_FALLBACK_SCSV   = 0x00000200L;
+    // SSL mode from ssl.h (OpenSSL 1.0.1u: upstream SSL_MODE_SEND_FALLBACK_SCSV is 0x80 and
+    // the Android handshake_cutthrough patch uses 0x200, as in Android 5.1; the stock 4.2
+    // OpenSSL 1.0.1c cut-through value 0x40 means SSL_MODE_SEND_SERVERHELLO_TIME there)
+    public static final long SSL_MODE_SEND_FALLBACK_SCSV   = 0x00000080L;
+    public static final long SSL_MODE_HANDSHAKE_CUTTHROUGH = 0x00000200L;
 
     // SSL options from ssl.h
+    public static final long SSL_OP_TLSEXT_PADDING                         = 0x00000010L;
     public static final long SSL_OP_NO_TICKET                              = 0x00004000L;
     public static final long SSL_OP_NO_SESSION_RESUMPTION_ON_RENEGOTIATION = 0x00010000L;
     public static final long SSL_OP_NO_SSLv3                               = 0x02000000L;
diff --git a/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java b/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java
index ba8ae623ac8..259fa109e92 100644
--- a/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java
+++ b/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java
@@ -1425,6 +1425,55 @@ public class SSLSocketTest extends TestCase {
         }
     }
 
+    public void test_SSLSocket_ClientHello_padding() throws Exception {
+        // kktls (OpenSSL 1.0.1u; the padding extension stays enabled, as in Android 5.0+): the
+        // SSL_OP_ALL that SSL_CTX_new sets includes SSL_OP_TLSEXT_PADDING, so OpenSSL pads a
+        // ClientHello that would be 256-511 bytes long (the F5 range of the test above) to 512
+        // bytes with the padding extension (RFC 7685). The SNI host name sets the length.
+        SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        String shortHost = "p.tls.test";
+        TlsRecord record = captureTlsHandshakeFirstTlsRecord(
+                wrappingClientSocketMaker(sf, shortHost));
+        int shortLength = record.fragment.length;
+        assertTrue("unpadded ClientHello should be shorter than 256 bytes: " + shortLength,
+                shortLength < 256);
+        assertNull("padding extension in a " + shortLength + "-byte ClientHello",
+                readClientHello(record).findExtensionByType(HelloExtension.TYPE_PADDING));
+
+        // the same ClientHello with a host name that makes it about 384 bytes long
+        StringBuilder longHost = new StringBuilder();
+        int extra = 384 - shortLength;
+        while (longHost.length() < extra) {
+            longHost.append(longHost.length() % 64 == 63 ? '.' : 'p');
+        }
+        if (longHost.charAt(longHost.length() - 1) == '.') {
+            longHost.append('p');
+        }
+        longHost.append('.').append(shortHost);
+        record = captureTlsHandshakeFirstTlsRecord(
+                wrappingClientSocketMaker(sf, longHost.toString()));
+        ClientHello clientHello = readClientHello(record);
+        ServerNameHelloExtension sniExtension = (ServerNameHelloExtension)
+                clientHello.findExtensionByType(HelloExtension.TYPE_SERVER_NAME);
+        assertNotNull(sniExtension);
+        assertEquals(Arrays.asList(longHost.toString()), sniExtension.hostnames);
+        assertNotNull("no padding extension in a " + record.fragment.length + "-byte ClientHello",
+                clientHello.findExtensionByType(HelloExtension.TYPE_PADDING));
+        assertTrue("padded ClientHello is " + record.fragment.length + " bytes, want 512",
+                record.fragment.length >= 512);
+    }
+
+    /** kktls: the ClientHello in {@code record}, which must hold nothing else. */
+    private static ClientHello readClientHello(TlsRecord record) throws Exception {
+        assertEquals("TLS record type", TlsProtocols.HANDSHAKE, record.type);
+        ByteArrayInputStream fragmentIn = new ByteArrayInputStream(record.fragment);
+        HandshakeMessage handshakeMessage = HandshakeMessage.read(new DataInputStream(fragmentIn));
+        assertEquals("HandshakeMessage type",
+                HandshakeMessage.TYPE_CLIENT_HELLO, handshakeMessage.type);
+        assertEquals(0, fragmentIn.available());
+        return (ClientHello) handshakeMessage;
+    }
+
     public void test_SSLSocket_ClientHello_cipherSuites() throws Exception {
         ForEachRunner.runNamed(new ForEachRunner.Callback<SSLSocketFactory>() {
             @Override
diff --git a/luni/src/test/java/org/apache/harmony/xnet/provider/jsse/NativeCryptoTest.java b/luni/src/test/java/org/apache/harmony/xnet/provider/jsse/NativeCryptoTest.java
index e98925e5d8f..e129b963f06 100644
--- a/luni/src/test/java/org/apache/harmony/xnet/provider/jsse/NativeCryptoTest.java
+++ b/luni/src/test/java/org/apache/harmony/xnet/provider/jsse/NativeCryptoTest.java
@@ -270,6 +270,8 @@ public class NativeCryptoTest extends TestCase {
         assertTrue((NativeCrypto.SSL_get_options(s) & NativeCrypto.SSL_OP_NO_TLSv1_1) == 0);
         assertTrue((NativeCrypto.SSL_get_options(s) & NativeCrypto.SSL_OP_NO_TLSv1_2) == 0);
 
+        assertTrue((NativeCrypto.SSL_get_options(s) & NativeCrypto.SSL_OP_TLSEXT_PADDING) != 0);
+
         int s2 = NativeCrypto.SSL_new(c);
         assertTrue(s != s2);
         NativeCrypto.SSL_free(s2);
