+    /**
+     * kktls test for cm-11 3f575a6 (= conscrypt 5af5e93): SSL_session_reused reports whether
+     * OpenSSL resumed the offered session, on both sides of the handshake.
+     */
+    public void test_SSL_session_reused() throws Exception {
+        try {
+            NativeCrypto.SSL_session_reused(NULL);
+            fail();
+        } catch (NullPointerException expected) {
+        }
+
+        {
+            int c = NativeCrypto.SSL_CTX_new();
+            int s = NativeCrypto.SSL_new(c);
+            assertFalse(NativeCrypto.SSL_session_reused(s));
+            NativeCrypto.SSL_free(s);
+            NativeCrypto.SSL_CTX_free(c);
+        }
+
+        final int clientContext = NativeCrypto.SSL_CTX_new();
+        final int serverContext = NativeCrypto.SSL_CTX_new();
+        final int otherServerContext = NativeCrypto.SSL_CTX_new();
+        final ServerSocket listener = new ServerSocket(0);
+        final int[] clientSession = new int[] { NULL };
+        try {
+            // full handshake: nothing offered, nothing reused
+            assertSessionReused(listener, clientContext, serverContext, NULL, clientSession, false);
+            // the client offers the session and the server resumes it
+            assertSessionReused(listener, clientContext, serverContext, clientSession[0], null, true);
+            // the client offers the session to a server that does not know it: full handshake
+            assertSessionReused(listener, clientContext, otherServerContext, clientSession[0], null,
+                                false);
+        } finally {
+            if (clientSession[0] != NULL) {
+                NativeCrypto.SSL_SESSION_free(clientSession[0]);
+            }
+            NativeCrypto.SSL_CTX_free(otherServerContext);
+            NativeCrypto.SSL_CTX_free(serverContext);
+            NativeCrypto.SSL_CTX_free(clientContext);
+            listener.close();
+        }
+    }
+
+    private static void assertSessionReused(ServerSocket listener, final int clientContext,
+                                            final int serverContext, final int sessionToOffer,
+                                            final int[] sessionOut, boolean expected)
+            throws Exception {
+        final boolean[] clientReused = new boolean[] { !expected };
+        final boolean[] serverReused = new boolean[] { !expected };
+        Hooks cHooks = new Hooks() {
+            @Override
+            public int getContext() throws SSLException {
+                return clientContext;
+            }
+            @Override
+            public int beforeHandshake(int c) throws SSLException {
+                int s = super.beforeHandshake(c);
+                if (sessionToOffer != NULL) {
+                    NativeCrypto.SSL_set_session(s, sessionToOffer);
+                }
+                return s;
+            }
+            @Override
+            public void afterHandshake(int session, int s, int c,
+                                       Socket sock, FileDescriptor fd,
+                                       SSLHandshakeCallbacks callback)
+                    throws Exception {
+                clientReused[0] = NativeCrypto.SSL_session_reused(s);
+                if (sessionOut != null) {
+                    sessionOut[0] = session;
+                    session = NULL;
+                }
+                super.afterHandshake(session, s, NULL, sock, fd, callback);
+            }
+        };
+        Hooks sHooks = new ServerHooks(getServerPrivateKey(), getServerCertificates()) {
+            @Override
+            public int getContext() throws SSLException {
+                return serverContext;
+            }
+            @Override
+            public void afterHandshake(int session, int s, int c,
+                                       Socket sock, FileDescriptor fd,
+                                       SSLHandshakeCallbacks callback)
+                    throws Exception {
+                serverReused[0] = NativeCrypto.SSL_session_reused(s);
+                super.afterHandshake(session, s, NULL, sock, fd, callback);
+            }
+        };
+        Future<TestSSLHandshakeCallbacks> client
+                = handshake(listener, 0, true, cHooks, null);
+        Future<TestSSLHandshakeCallbacks> server
+                = handshake(listener, 0, false, sHooks, null);
+        client.get(TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        server.get(TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        assertEquals("client SSL_session_reused", expected, clientReused[0]);
+        assertEquals("server SSL_session_reused", expected, serverReused[0]);
+    }
+
