+package org.apache.harmony.xnet.provider.jsse;
+
+import java.lang.reflect.Field;
+import java.security.cert.TrustAnchor;
+import java.security.cert.X509Certificate;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import javax.security.auth.x500.X500Principal;
+import junit.framework.TestCase;
+import libcore.java.security.TestKeyStore;
+
+/**
+ * kktls tests for cm-11 5549787 (= conscrypt 4bdc877, Dec-2015 security bulletin): since 02e4d22
+ * TrustManagerImpl indexes the intermediates of every validated chain, so the same certificate
+ * must be stored once, however often it is indexed.
+ */
+public class TrustedCertificateIndexTest extends TestCase {
+
+    public void testIndexSameCertificateOnce() throws Exception {
+        X509Certificate[] chain = (X509Certificate[]) TestKeyStore.getServer()
+                .getPrivateKey("RSA", "RSA").getCertificateChain();
+        X509Certificate server = chain[0];
+        X509Certificate intermediate = chain[1];
+
+        TrustedCertificateIndex index = new TrustedCertificateIndex();
+        for (int i = 0; i < 5; i++) {
+            index.index(intermediate);
+        }
+        index.index(new TrustAnchor(intermediate, null));
+
+        assertEquals(1, anchorsFor(index, intermediate.getSubjectX500Principal()).size());
+        assertNotNull(index.findBySubjectAndPublicKey(intermediate));
+        TrustAnchor issuer = index.findByIssuerAndSignature(server);
+        assertNotNull(issuer);
+        assertEquals(intermediate, issuer.getTrustedCert());
+    }
+
+    public void testIndexKeepsDistinctCertificatesWithSameSubject() throws Exception {
+        String subject = "CN=TLS Test Same Subject CA";
+        TestKeyStore ca1 = new TestKeyStore.Builder()
+                .keyAlgorithms("RSA").aliasPrefix("SameSubjectCA1").subject(subject).ca(true)
+                .build();
+        TestKeyStore ca2 = new TestKeyStore.Builder()
+                .keyAlgorithms("RSA").aliasPrefix("SameSubjectCA2").subject(subject).ca(true)
+                .build();
+        X509Certificate cert1 = ca1.getRootCertificate("RSA");
+        X509Certificate cert2 = ca2.getRootCertificate("RSA");
+        assertFalse(cert1.equals(cert2));
+        X509Certificate leaf2 = (X509Certificate) new TestKeyStore.Builder()
+                .keyAlgorithms("RSA").aliasPrefix("SameSubjectLeaf")
+                .signer(ca2.getPrivateKey("RSA", "RSA")).rootCa(cert2)
+                .build().getPrivateKey("RSA", "RSA").getCertificate();
+
+        TrustedCertificateIndex index = new TrustedCertificateIndex();
+        index.index(cert1);
+        index.index(cert2);
+        index.index(cert1);
+        index.index(cert2);
+
+        assertEquals(2, anchorsFor(index, new X500Principal(subject)).size());
+        TrustAnchor issuer = index.findByIssuerAndSignature(leaf2);
+        assertNotNull(issuer);
+        assertEquals(cert2, issuer.getTrustedCert());
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<TrustAnchor> anchorsFor(TrustedCertificateIndex index,
+            X500Principal subject) throws Exception {
+        Field field = TrustedCertificateIndex.class.getDeclaredField("subjectToTrustAnchors");
+        field.setAccessible(true);
+        Map<X500Principal, List<TrustAnchor>> map =
+                (Map<X500Principal, List<TrustAnchor>>) field.get(index);
+        synchronized (map) {
+            List<TrustAnchor> anchors = map.get(subject);
+            return (anchors == null)
+                    ? Collections.<TrustAnchor>emptyList()
+                    : new ArrayList<TrustAnchor>(anchors);
+        }
+    }
+}
