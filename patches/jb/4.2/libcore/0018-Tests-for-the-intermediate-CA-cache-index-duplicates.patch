@@ -360,6 +360,58 @@ public class SSLSocketTest extends TestCase {
         c.close();
     }
 
+    /**
+     * kktls test for cm-11 3f575a6 (= conscrypt 5af5e93): the client takes over its cached session
+     * object only when OpenSSL resumed it. Every connection wraps a plain socket with the same
+     * host and port, so the client offers the cached session to whichever server it reaches.
+     */
+    public void test_SSLSocket_sessionReuse_onlyWhenResumed() throws Exception {
+        TestSSLContext a = TestSSLContext.create();
+        // b has its own server session cache, so it cannot resume a's sessions
+        TestSSLContext b = TestSSLContext.create();
+        SSLSocketFactory cf = a.clientContext.getSocketFactory();
+        try {
+            SSLSession first = handshakeWrapped(cf, a, "reuse.tls.test", 443);
+            SSLSession resumed = handshakeWrapped(cf, a, "reuse.tls.test", 443);
+            assertSame(first, resumed);
+
+            SSLSession fresh = handshakeWrapped(cf, b, "reuse.tls.test", 443);
+            assertNotSame(first, fresh);
+            assertFalse(Arrays.equals(first.getId(), fresh.getId()));
+            assertTrue(fresh.isValid());
+
+            // the new session replaced the old one in the client cache
+            SSLSession resumedFresh = handshakeWrapped(cf, b, "reuse.tls.test", 443);
+            assertSame(fresh, resumedFresh);
+        } finally {
+            a.close();
+            b.close();
+        }
+    }
+
+    private static SSLSession handshakeWrapped(SSLSocketFactory cf, TestSSLContext server,
+                                               String host, int port) throws Exception {
+        Socket plain = new Socket(server.host, server.port);
+        SSLSocket client = (SSLSocket) cf.createSocket(plain, host, port, true);
+        final SSLSocket accepted = (SSLSocket) server.serverSocket.accept();
+        ExecutorService executor = Executors.newSingleThreadExecutor();
+        Future<Void> future = executor.submit(new Callable<Void>() {
+            @Override public Void call() throws Exception {
+                accepted.startHandshake();
+                return null;
+            }
+        });
+        executor.shutdown();
+        try {
+            client.startHandshake();
+            future.get();
+            return client.getSession();
+        } finally {
+            client.close();
+            accepted.close();
+        }
+    }
+
