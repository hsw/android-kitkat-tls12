+    /**
+     * kktls test for cm-11 02e4d22 (= conscrypt 04e7d1d, Dec-2015 security bulletin): a learned
+     * intermediate CA is cached to complete short chains, but it must not become a trust anchor.
+     * Its own constraints (here: an IP name constraint) still apply to every chain through it.
+     */
+    public void testLearnedIntermediateIsNotTrustAnchor() throws Exception {
+        TestKeyStore rootCa = TestKeyStore.getRootCa();
+        X509Certificate root = rootCa.getRootCertificate("RSA");
+        TestKeyStore constrainedCa = new TestKeyStore.Builder()
+                .keyAlgorithms("RSA")
+                .aliasPrefix("ConstrainedCA")
+                .subject("CN=TLS Test Constrained Intermediate CA")
+                .ca(true)
+                .addNameConstraint(true, new byte[] { 10, 0, 0, 0, (byte) 255, 0, 0, 0 })
+                .signer(rootCa.getPrivateKey("RSA", "RSA"))
+                .rootCa(root)
+                .build();
+        X509Certificate intermediate =
+                (X509Certificate) constrainedCa.getPrivateKey("RSA", "RSA").getCertificate();
+        X509Certificate inside = leafWithIpAddress(constrainedCa, new byte[] { 10, 0, 0, 1 });
+        X509Certificate outside =
+                leafWithIpAddress(constrainedCa, new byte[] { (byte) 192, (byte) 168, 0, 1 });
+        X509Certificate[] insideChain = new X509Certificate[] { inside, intermediate };
+        X509Certificate[] outsideChain = new X509Certificate[] { outside, intermediate };
+
+        // A fresh trust manager enforces the intermediate's name constraint.
+        assertInvalid(outsideChain, trustManagerImpl(root));
+
+        TrustManagerImpl tm = trustManagerImpl(root);
+        assertValid(insideChain, tm);
+        // The learned intermediate is not an anchor: its constraint still rejects the other leaf,
+        // with or without the intermediate in the presented chain ...
+        assertInvalid(outsideChain, tm);
+        assertInvalid(new X509Certificate[] { outside }, tm);
+        // ... and it still completes a chain that lacks it (http://b/3404902).
+        assertValid(new X509Certificate[] { inside }, tm);
+    }
+
+    /**
+     * kktls test for cm-11 02e4d22: a chain completed from the learned intermediate ends at the
+     * root, not at the intermediate. Same assertions as testGetFullChain, but on a directly
+     * constructed TrustManagerImpl: testGetFullChain takes the trust manager from the default
+     * provider, which on host Dalvik is the jarjar'd com.android.org.apache.harmony.xnet.provider.jsse class, so its
+     * instanceof check fails there before it gets to the chains.
+     */
+    public void testLearnedIntermediateCompletesChainToRoot() throws Exception {
+        KeyStore.PrivateKeyEntry pke = TestKeyStore.getServer().getPrivateKey("RSA", "RSA");
+        X509Certificate[] chain3 = (X509Certificate[]) pke.getCertificateChain();
+        X509Certificate root = chain3[2];
+        X509Certificate[] chain2 = new X509Certificate[] { chain3[0], chain3[1] };
+        X509Certificate[] chain1 = new X509Certificate[] { chain3[0] };
+
+        TrustManagerImpl tm = trustManagerImpl(root);
+        assertEquals(Arrays.asList(chain3), tm.checkServerTrusted(chain2, "RSA", "purple.com"));
+        assertEquals(Arrays.asList(chain3), tm.checkServerTrusted(chain1, "RSA", "purple.com"));
+        assertEquals(Arrays.asList(chain3), tm.checkServerTrusted(chain2, "RSA", "purple.com"));
+    }
+
+    private static TrustManagerImpl trustManagerImpl(X509Certificate ca) throws Exception {
+        KeyStore keyStore = TestKeyStore.createKeyStore();
+        keyStore.setCertificateEntry("alias", ca);
+        return new TrustManagerImpl(keyStore);
+    }
+
+    private static X509Certificate leafWithIpAddress(TestKeyStore ca, byte[] ipAddress)
+            throws Exception {
+        return (X509Certificate) new TestKeyStore.Builder()
+                .keyAlgorithms("RSA")
+                .aliasPrefix("ConstrainedLeaf")
+                .addSubjectAltNameIpAddress(ipAddress)
+                .signer(ca.getPrivateKey("RSA", "RSA"))
+                .rootCa(ca.getRootCertificate("RSA"))
+                .build()
+                .getPrivateKey("RSA", "RSA")
+                .getCertificate();
+    }
+
