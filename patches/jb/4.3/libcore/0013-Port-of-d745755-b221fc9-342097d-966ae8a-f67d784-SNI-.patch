+package org.apache.harmony.xnet.provider.jsse;
+
+import java.net.InetAddress;
+
+/**
+ * Platform-specific methods of the KitKat org.conscrypt.Platform that the SNI code
+ * (AddressUtils) needs; Android 4.3 has no Platform class in this package.
+ */
+class Platform {
+    private Platform() {
+    }
+
+    /**
+     * Returns true if the supplied hostname is an literal IP address.
+     */
+    public static boolean isLiteralIpAddress(String hostname) {
+        return InetAddress.isNumeric(hostname);
+    }
+}
