     }
 
+    /**
+     * Returns the host name to send in the Server Name Indication (SNI) extension, or null. The
+     * caller sends it only if {@link AddressUtils#isValidSniHostname} accepts it (a fully qualified
+     * domain name, not an IP literal; RFC 6066 section 3).
+     *
+     * <p>An explicit {@link #setHostname} wins ({@code null} turns SNI off). Otherwise SNI is on
+     * unless {@code jsse.enableSNIExtension} is {@code false}, and the name is the host this socket
+     * was created with or the host given for the wrapped socket. It is never derived from
+     * {@link #getPeerHostName} or {@code getInetAddress().getHostName()}, which can do a reverse
+     * DNS lookup.
+     *
+     * <p>kktls port of conscrypt d745755, b221fc9, 342097d, 966ae8a and f67d784 (SNI by default in
+     * Android 6.0) onto the 4.3 socket, which keeps its SNI settings itself.
+     */
+    private String getSniHostname() {
+        if (useSni != null) {
+            return useSni.booleanValue() ? hostname : null;
+        }
+        if (!isSniEnabledByDefault()) {
+            return null;
+        }
+        return (peerHostname != null) ? peerHostname : wrappedHost;
+    }
+
+    /**
+     * Returns whether Server Name Indication (SNI) is enabled by default for
+     * sockets. For more information on SNI, see RFC 6066 section 3.
+     */
+    private static boolean isSniEnabledByDefault() {
+        String enableSNI = System.getProperty("jsse.enableSNIExtension", "true");
+        if ("true".equalsIgnoreCase(enableSNI)) {
+            return true;
+        } else if ("false".equalsIgnoreCase(enableSNI)) {
+            return false;
+        } else {
+            throw new RuntimeException(
+                    "Can only set \"jsse.enableSNIExtension\" to \"true\" or \"false\"");
+        }
+    }
+
     String getPeerHostName() {
         if (wrappedHost != null) {
             return wrappedHost;
@@ -802,6 +856,7 @@ public class OpenSSLSocketImpl
      * @param hostname the desired SNI hostname, or null to disable
      */
     public void setHostname(String hostname) {
+        this.useSni = Boolean.valueOf(hostname != null);
         this.hostname = hostname;
     }
 
