+    // SNI by default (the behaviour of conscrypt d745755, b221fc9, 342097d, 966ae8a and
+    // f67d784): the host name in the ClientHello for each way a client socket learns its peer's
+    // host. test_SSLSocket_ClientHello_SNI above covers a wrapped socket on every factory.
+
+    public void test_SSLSocket_SNI_createdWithHostname() throws Exception {
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        final String host = "sni-created.tls.test";
+        assertEquals(Arrays.asList(host), captureSniHostnames(new ClientSocketMaker() {
+            public SSLSocket make(ServerSocket listeningSocket, Socket[] sockets)
+                    throws Exception {
+                cacheLoopbackName(host);
+                return (SSLSocket) sf.createSocket(host, listeningSocket.getLocalPort());
+            }
+        }));
+        assertEquals(Arrays.asList(host), captureSniHostnames(new ClientSocketMaker() {
+            public SSLSocket make(ServerSocket listeningSocket, Socket[] sockets)
+                    throws Exception {
+                cacheLoopbackName(host);
+                return (SSLSocket) sf.createSocket(host, listeningSocket.getLocalPort(), null, 0);
+            }
+        }));
+    }
+
+    public void test_SSLSocket_SNI_ipLiteral() throws Exception {
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        // RFC 6066 section 3: no IP literals in SNI (342097d, f67d784)
+        assertNull("created with an InetAddress", captureSniHostnames(new ClientSocketMaker() {
+            public SSLSocket make(ServerSocket listeningSocket, Socket[] sockets)
+                    throws Exception {
+                return (SSLSocket) sf.createSocket(
+                        InetAddress.getByAddress(new byte[] { 127, 0, 0, 1 }),
+                        listeningSocket.getLocalPort());
+            }
+        }));
+        assertNull("created with \"127.0.0.1\"", captureSniHostnames(new ClientSocketMaker() {
+            public SSLSocket make(ServerSocket listeningSocket, Socket[] sockets)
+                    throws Exception {
+                return (SSLSocket) sf.createSocket("127.0.0.1", listeningSocket.getLocalPort());
+            }
+        }));
+        for (String ip : new String[] { "127.0.0.1", "::1", "::ffff:127.0.0.1", "2001:db8::1" }) {
+            assertNull("wrapped with " + ip,
+                    captureSniHostnames(wrappingClientSocketMaker(sf, ip)));
+        }
+        assertNull("setHostname(\"127.0.0.1\")", captureSniHostnames(withSetHostname(
+                wrappingClientSocketMaker(sf, "sni-wrapped.tls.test"), "127.0.0.1")));
+    }
+
+    public void test_SSLSocket_SNI_ipLiteral_noReverseDns() throws Exception {
+        // The SNI host comes from the host the socket was created or wrapped with, never from
+        // getInetAddress().getHostName(): a wrapped socket whose host is an IP literal must leave
+        // the peer InetAddress unresolved.
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        final InetAddress peer = InetAddress.getByAddress(new byte[] { 127, 0, 0, 1 });
+        assertNull(inetAddressHostName(peer));
+        assertNull(captureSniHostnames(new ClientSocketMaker() {
+            public SSLSocket make(ServerSocket listeningSocket, Socket[] sockets)
+                    throws Exception {
+                Socket client = new Socket();
+                sockets[0] = client;
+                client.connect(new InetSocketAddress(peer, listeningSocket.getLocalPort()));
+                return (SSLSocket) sf.createSocket(
+                        client, "127.0.0.1", listeningSocket.getLocalPort(), true);
+            }
+        }));
+        assertNull("reverse DNS of the peer address", inetAddressHostName(peer));
+    }
+
+    public void test_SSLSocket_SNI_disabledByProperty() throws Exception {
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        String old = System.getProperty("jsse.enableSNIExtension");
+        System.setProperty("jsse.enableSNIExtension", "false");
+        try {
+            assertNull(captureSniHostnames(
+                    wrappingClientSocketMaker(sf, "sni-wrapped.tls.test")));
+            // an explicit setHostname() (okhttp, SSLCertificateSocketFactory) still sends SNI
+            assertEquals(Arrays.asList("sni-explicit.tls.test"),
+                    captureSniHostnames(withSetHostname(
+                            wrappingClientSocketMaker(sf, "sni-wrapped.tls.test"),
+                            "sni-explicit.tls.test")));
+        } finally {
+            if (old == null) {
+                System.clearProperty("jsse.enableSNIExtension");
+            } else {
+                System.setProperty("jsse.enableSNIExtension", old);
+            }
+        }
+    }
+
+    public void test_SSLSocket_SNI_setHostname() throws Exception {
+        final SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
+        // an explicit setHostname() wins over the wrapped host ...
+        assertEquals(Arrays.asList("sni-explicit.tls.test"),
+                captureSniHostnames(withSetHostname(
+                        wrappingClientSocketMaker(sf, "sni-wrapped.tls.test"),
+                        "sni-explicit.tls.test")));
+        // ... and setHostname(null) turns SNI off
+        assertNull(captureSniHostnames(withSetHostname(
+                wrappingClientSocketMaker(sf, "sni-wrapped.tls.test"), null)));
+    }
