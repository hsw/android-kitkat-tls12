+    /** kktls: makes the client SSLSocket, connected to the capturing listening socket. */
+    private interface ClientSocketMaker {
+        /** A plain socket that must be closed on failure goes into sockets[0]. */
+        SSLSocket make(ServerSocket listeningSocket, Socket[] sockets) throws Exception;
+    }
+
+    /** kktls: upstream's client: a plain socket wrapped by sslSocketFactory with {@code host}. */
+    private static ClientSocketMaker wrappingClientSocketMaker(
+            final SSLSocketFactory sslSocketFactory, final String host) {
+        return new ClientSocketMaker() {
+            public SSLSocket make(ServerSocket listeningSocket, Socket[] sockets)
+                    throws Exception {
+                Socket client = new Socket();
+                sockets[0] = client;
+                client.connect(listeningSocket.getLocalSocketAddress());
+                return (SSLSocket) sslSocketFactory.createSocket(
+                        client, host, listeningSocket.getLocalPort(), true);
+            }
+        };
+    }
+
+    /** kktls: calls the platform socket's setHostname(String) (as okhttp does) before the handshake. */
+    private static ClientSocketMaker withSetHostname(
+            final ClientSocketMaker clientSocketMaker, final String hostname) {
+        return new ClientSocketMaker() {
+            public SSLSocket make(ServerSocket listeningSocket, Socket[] sockets)
+                    throws Exception {
+                SSLSocket socket = clientSocketMaker.make(listeningSocket, sockets);
+                socket.getClass().getMethod("setHostname", String.class).invoke(socket, hostname);
+                return socket;
+            }
+        };
+    }
+
+    /** kktls: the host names of the ClientHello's server_name extension, or null without one. */
+    private List<String> captureSniHostnames(ClientSocketMaker clientSocketMaker)
+            throws Exception {
+        ClientHello clientHello = captureTlsHandshakeClientHello(clientSocketMaker);
+        ServerNameHelloExtension sniExtension = (ServerNameHelloExtension)
+                clientHello.findExtensionByType(HelloExtension.TYPE_SERVER_NAME);
+        return (sniExtension != null) ? sniExtension.hostnames : null;
+    }
+
+    /**
+     * kktls: maps {@code name} to 127.0.0.1 in libcore's InetAddress cache (2 s TTL), so that the
+     * String-host constructors resolve a test name without DNS (Android libcore only).
+     */
+    private static void cacheLoopbackName(String name) throws Exception {
+        Field cacheField = InetAddress.class.getDeclaredField("addressCache");
+        cacheField.setAccessible(true);
+        Object cache = cacheField.get(null);
+        Method put = cache.getClass().getDeclaredMethod("put", String.class, InetAddress[].class);
+        put.setAccessible(true);
+        put.invoke(cache, name, new InetAddress[] {
+                InetAddress.getByAddress(name, new byte[] { 127, 0, 0, 1 }) });
+    }
+
+    /** kktls: the host name an InetAddress holds (null until a lookup or a constructor sets it). */
+    private static String inetAddressHostName(InetAddress address) throws Exception {
+        Field hostName = InetAddress.class.getDeclaredField("hostName");
+        hostName.setAccessible(true);
+        return (String) hostName.get(address);
+    }
