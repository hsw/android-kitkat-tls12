+    /**
+     * kktls test for the cycle guard (libcore/0022) of the learned-intermediate loop of cm-11
+     * 02e4d22. CAs I and J cross-sign each other (I_J: subject I, issued by J; J_I: subject J,
+     * issued by I), and I also has a certificate from the trusted root (I_R). The valid chain
+     * L, I_J, J_I, I_R teaches the trust manager I_J, J_I and I_R in that order. The index
+     * returns the first cached I whose key verifies, which is I_J, so completing the bare leaf
+     * walks L, I_J, J_I, I_J, J_I, ... Without a guard the chain array doubles until the VM
+     * runs out of memory; with it the walk stops at the first repeated certificate and the
+     * check fails cleanly (the anchor is not reached through the cycle).
+     */
+    public void testLearnedIntermediateCrossSignedPairTerminates() throws Exception {
+        TestKeyStore rootCa = TestKeyStore.getRootCa();
+        KeyStore.PrivateKeyEntry rootEntry = rootCa.getPrivateKey("RSA", "RSA");
+        X509Certificate root = (X509Certificate) rootEntry.getCertificate();
+        KeyPair keyI = rsaKeyPair();
+        KeyPair keyJ = rsaKeyPair();
+        X500Principal nameI = new X500Principal("CN=TLS Test Cross-Signed CA I");
+        X500Principal nameJ = new X500Principal("CN=TLS Test Cross-Signed CA J");
+        X509Certificate iByRoot = certificate(101, nameI, keyI.getPublic(),
+                root.getSubjectX500Principal(), rootEntry.getPrivateKey(), true);
+        X509Certificate iByJ = certificate(102, nameI, keyI.getPublic(), nameJ,
+                keyJ.getPrivate(), true);
+        X509Certificate jByI = certificate(103, nameJ, keyJ.getPublic(), nameI,
+                keyI.getPrivate(), true);
+        X509Certificate leaf = certificate(104, new X500Principal("CN=leaf.tls.test"),
+                rsaKeyPair().getPublic(), nameI, keyI.getPrivate(), false);
+
+        TrustManagerImpl tm = trustManagerImpl(root);
+        // A fresh trust manager cannot complete the bare leaf.
+        assertInvalidWithin(new X509Certificate[] { leaf }, tm);
+        // The full chain is valid and caches I_J, J_I and I_R.
+        assertValid(new X509Certificate[] { leaf, iByJ, jByI, iByRoot }, tm);
+        // The bare leaf is completed through the cycle: this must end, with a failure.
+        assertInvalidWithin(new X509Certificate[] { leaf }, tm);
+        // A presented chain that ends in the cycle stops there too.
+        assertInvalidWithin(new X509Certificate[] { leaf, iByJ, jByI }, tm);
+        // The chain through the root-signed certificate still validates.
+        assertValid(new X509Certificate[] { leaf, iByRoot }, tm);
+        assertValid(new X509Certificate[] { leaf, iByJ, jByI, iByRoot }, tm);
+    }
+
+    /**
+     * assertInvalid in a worker thread, so that a chain walk that never ends fails this test
+     * after a timeout instead of hanging the whole run.
+     */
+    private void assertInvalidWithin(final X509Certificate[] chain, final X509TrustManager tm)
+            throws Exception {
+        final Throwable[] failure = new Throwable[1];
+        final boolean[] done = new boolean[1];
+        Thread worker = new Thread(new Runnable() {
+            public void run() {
+                try {
+                    assertInvalid(chain, tm);
+                } catch (Throwable t) {
+                    failure[0] = t;
+                }
+                synchronized (done) {
+                    done[0] = true;
+                }
+            }
+        });
+        worker.setDaemon(true);
+        worker.start();
+        worker.join(60 * 1000);
+        synchronized (done) {
+            assertTrue("chain check did not terminate within 60 s", done[0]);
+        }
+        if (failure[0] instanceof Error) {
+            throw (Error) failure[0];
+        }
+        if (failure[0] != null) {
+            throw new AssertionError(failure[0]);
+        }
+    }
+
+    private static KeyPair rsaKeyPair() throws Exception {
+        KeyPairGenerator kpg = KeyPairGenerator.getInstance("RSA");
+        kpg.initialize(1024);
+        return kpg.generateKeyPair();
+    }
+
+    private static X509Certificate certificate(long serial, X500Principal subject,
+            PublicKey subjectKey, X500Principal issuer, PrivateKey issuerKey, boolean ca)
+            throws Exception {
+        long now = System.currentTimeMillis();
+        long day = 24 * 60 * 60 * 1000L;
+        X509V3CertificateGenerator generator = new X509V3CertificateGenerator();
+        generator.setSerialNumber(BigInteger.valueOf(serial));
+        generator.setSubjectDN(subject);
+        generator.setIssuerDN(issuer);
+        generator.setNotBefore(new Date(now - day));
+        generator.setNotAfter(new Date(now + day));
+        generator.setPublicKey(subjectKey);
+        generator.setSignatureAlgorithm("SHA256withRSA");
+        if (ca) {
+            generator.addExtension(X509Extensions.BasicConstraints, true,
+                    new BasicConstraints(true));
+        }
+        return generator.generateX509Certificate(issuerKey);
+    }
+
     private static TrustManagerImpl trustManagerImpl(X509Certificate ca) throws Exception {
         KeyStore keyStore = TestKeyStore.createKeyStore();
         keyStore.setCertificateEntry("alias", ca);
