         if (isClosed()) {
             throw new SocketException("Socket is closed");
diff --git a/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java b/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java
index 74b02c8780c..2d6e17277e6 100644
--- a/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java
+++ b/luni/src/test/java/libcore/javax/net/ssl/SSLSocketTest.java
@@ -407,10 +407,48 @@ public class SSLSocketTest extends TestCase {
         }
     }
 
+    /**
+     * kktls: a client session cached over a lower protocol than the highest enabled one is not
+     * offered. OpenSSL's SSL_set_session switches the SSL to the session's version, so a TLSv1
+     * session (for example one cached before the upgrade to the TLS 1.2 defaults) would keep
+     * the host on TLSv1 for as long as the server resumes it, or forever if it never does.
+     */
+    public void test_SSLSocket_sessionReuse_lowerProtocolNotOffered() throws Exception {
+        TestSSLContext c = TestSSLContext.create();
+        SSLSocketFactory cf = c.clientContext.getSocketFactory();
+        String[] tls1 = new String[] { "TLSv1" };
+        try {
+            SSLSession old = handshakeWrapped(cf, c, "proto.tls.test", 443, tls1);
+            assertEquals("TLSv1", old.getProtocol());
+            // a socket with the same protocols (also okhttp's TLSv1 fallback) still resumes it
+            assertSame(old, handshakeWrapped(cf, c, "proto.tls.test", 443, tls1));
+
+            // the default protocols (up to TLSv1.2) do not offer it: a full TLSv1.2 handshake
+            SSLSession upgraded = handshakeWrapped(cf, c, "proto.tls.test", 443, null);
+            assertEquals("TLSv1.2", upgraded.getProtocol());
+            assertNotSame(old, upgraded);
+            assertFalse(Arrays.equals(old.getId(), upgraded.getId()));
+            // the TLSv1.2 session replaced it in the client cache and is resumed
+            assertSame(upgraded, handshakeWrapped(cf, c, "proto.tls.test", 443, null));
+        } finally {
+            c.close();
+        }
+    }
+
     private static SSLSession handshakeWrapped(SSLSocketFactory cf, TestSSLContext server,
                                                String host, int port) throws Exception {
+        return handshakeWrapped(cf, server, host, port, null);
+    }
+
+    /** kktls: {@code protocols} (null = the defaults) are enabled on the client socket only. */
